NODE_ENV=development
APP_ENV=local
API_PORT=4000
DATABASE_URL=postgresql://galung:local_only@localhost:5432/galung
REDIS_URL=redis://localhost:6379
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Identity remains fail-closed until all values below are supplied and the
# draft identity migrations have been validated on the target PostgreSQL 16.
IDENTITY_ENABLED=false
# CUSTOMER_ORIGIN=http://localhost:3000
# ADMIN_ORIGIN=http://localhost:3001
# IDENTITY_CSRF_KEY=<64 random hexadecimal characters>
# IDENTITY_ENCRYPTION_KEY=<different 64 random hexadecimal characters>
# IDENTITY_OUTBOX_KEY=<third 64 random hexadecimal characters>
# SESSION_CUSTOMER_IDLE_MINUTES=<approved value>
# SESSION_CUSTOMER_ABSOLUTE_MINUTES=<approved value>
# SESSION_ADMIN_IDLE_MINUTES=<approved value>
# SESSION_ADMIN_ABSOLUTE_MINUTES=<approved value>
# CHALLENGE_EMAIL_MINUTES=<approved value>
# CHALLENGE_RESET_MINUTES=<approved value>
# CHALLENGE_MFA_MINUTES=<approved value>
# MFA_CHALLENGE_MAX_ATTEMPTS=<reviewed value>
# IDENTITY_MAIL_POLL_MS=<reviewed value>
# IDENTITY_RATE_LIMIT_MAX=<approved value>
# IDENTITY_RATE_LIMIT_WINDOW_SECONDS=<approved value>
# ARGON2_MEMORY_KIB=<reviewed value>
# ARGON2_TIME_COST=<reviewed value>
# ARGON2_PARALLELISM=<reviewed value>
# LEGAL_TERMS_VERSION=<published Legal-approved version>
# LEGAL_TERMS_SHA256=<SHA-256 of exact published text>
# LEGAL_PRIVACY_VERSION=<published Legal-approved version>
# LEGAL_PRIVACY_SHA256=<SHA-256 of exact published text>
# SMTP_URL=<approved SMTP transport URL>
# SMTP_FROM=<verified sender address>
# Web-only public Legal metadata: set only after final Legal approval/publication.
# NEXT_PUBLIC_LEGAL_TERMS_VERSION=<same approved version as API>
# NEXT_PUBLIC_LEGAL_TERMS_URL=<HTTPS URL of exact published Terms>
# NEXT_PUBLIC_LEGAL_PRIVACY_VERSION=<same approved version as API>
# NEXT_PUBLIC_LEGAL_PRIVACY_URL=<HTTPS URL of exact published Privacy Notice>
