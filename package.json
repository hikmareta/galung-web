{
  "name": "galung-platform",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:browser": "playwright test",
    "check:env": "node --import tsx scripts/check-env.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:check": "node --import tsx scripts/check-db.ts",
    "db:identity:verify": "node --import tsx scripts/verify-identity-db.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.4",
    "eslint": "^9.25.1",
    "pg": "^8.16.0",
    "tsx": "^4.19.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ]
  }
